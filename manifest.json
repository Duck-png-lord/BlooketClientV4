{
  "manifest_version": 3,
  "name": "BlooketClientV4",
  "version": "1.0",
  "description": "Shows correct answers in green, wrong in red, and chest contents (toggleable) - For educational purposes only",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.blooket.com/*"],
      "js": ["content.js"]
    }
  ]
}

